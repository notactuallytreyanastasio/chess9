{
  "name": "chess9",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chess-9: a 3x3 continuous-plane chess variant with cross-board piece replacement.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle": "vite build && node scripts/verify-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8"
  }
}
